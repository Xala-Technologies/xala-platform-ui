{
  "$schema": "@xala-technologies/gazetteer/schemas/page.spec.schema.json",
  "pageId": "calendar",
  "layoutType": "dashboard",
  "shellType": "authenticated",
  "controllerRefs": [],
  "widgets": {
    "header": [
      {
        "widgetId": "page-header",
        "type": "PageHeader",
        "props": {
          "titleKey": "calendar.title",
          "subtitleKey": "calendar.subtitle"
        }
      }
    ],
    "content": [
      {
        "widgetId": "main-content",
        "type": "Card",
        "props": {
          "titleKey": "calendar.content.title"
        }
      }
    ]
  },
  "i18nRequiredKeys": [
    "calendar.title",
    "calendar.subtitle",
    "calendar.content.title"
  ]
}