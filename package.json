{
  "name": "@xala-technologies/platform-ui",
  "version": "2.0.0",
  "description": "Norwegian Designsystemet-based React component library for Xala platform applications",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives/index.js",
      "require": "./dist/primitives/index.cjs"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "require": "./dist/components/index.cjs"
    },
    "./layouts": {
      "types": "./dist/layouts/index.d.ts",
      "import": "./dist/layouts/index.js",
      "require": "./dist/layouts/index.cjs"
    },
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "import": "./dist/themes/index.js",
      "require": "./dist/themes/index.cjs"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js",
      "require": "./dist/tokens/index.cjs"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.cjs"
    },
    "./styles": {
      "types": "./dist/styles.d.ts",
      "import": "./dist/styles.js",
      "require": "./dist/styles.cjs"
    },
    "./features/*": {
      "types": "./dist/features/*/index.d.ts",
      "import": "./dist/features/*/index.js",
      "require": "./dist/features/*/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "quality": "pnpm typecheck && pnpm lint && pnpm format:check",
    "verify:boundaries": "node scripts/verify-boundaries.js",
    "verify:design-tokens": "node scripts/verify-design-tokens.js",
    "verify:accessibility": "node scripts/scan-accessibility.js",
    "verify:all": "pnpm verify:boundaries && pnpm verify:design-tokens",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test:storybook": "test-storybook",
    "test:a11y": "pnpm test:storybook",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest watch",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "xala",
    "xalatechnologies",
    "ui",
    "design-system",
    "designsystemet",
    "norwegian",
    "react",
    "components",
    "typescript",
    "accessibility"
  ],
  "author": "Xala Technologies",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xala-Technologies/xala-platform-ui.git"
  },
  "bugs": {
    "url": "https://github.com/Xala-Technologies/xala-platform-ui/issues"
  },
  "homepage": "https://github.com/Xala-Technologies/xala-platform-ui#readme",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@digdir/designsystemet-css": "^1.0.0",
    "@digdir/designsystemet-react": "^1.0.0",
    "@fontsource/inter": "^5.2.8",
    "@navikt/aksel-icons": "^8.3.0",
    "dompurify": "^3.3.1",
    "lucide-react": "^0.462.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-a11y": "^8.6.15",
    "@storybook/addon-coverage": "^3.0.0",
    "@storybook/addon-docs": "^8.6.15",
    "@storybook/addon-essentials": "^8.6.15",
    "@storybook/addon-links": "^8.6.15",
    "@storybook/addon-viewport": "8.6.15",
    "@storybook/blocks": "^8.6.15",
    "@storybook/manager-api": "^8.6.15",
    "@storybook/react": "^8.6.15",
    "@storybook/react-vite": "^8.6.15",
    "@storybook/test": "^8.6.15",
    "@storybook/test-runner": "^0.24.2",
    "@storybook/theming": "^8.6.15",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^1.2.0",
    "axe-playwright": "^2.2.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.18.0",
    "globals": "^17.1.0",
    "http-server": "^14.1.1",
    "jsdom": "^25.0.1",
    "playwright": "^1.57.0",
    "prettier": "^3.2.5",
    "storybook": "^8.6.15",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0",
    "wait-on": "^9.0.3"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}