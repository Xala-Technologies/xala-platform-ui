#!/usr/bin/env node
/**
 * Generate Platform-UI Examples Catalog
 * 
 * Generates thousands of examples covering all platform-ui components,
 * patterns, and recipes to help AI understand the design system.
 */

import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

// Comprehensive component configurations
const components = {
  Stack: {
    directions: ['vertical', 'horizontal'],
    gaps: ['xs', 'sm', 'md', 'lg', 'xl'],
    aligns: ['start', 'center', 'end', 'stretch', 'baseline'],
    justifies: ['start', 'center', 'end', 'between', 'around', 'evenly'],
    paddings: ['xs', 'sm', 'md', 'lg', 'xl'],
    responsive: true,
  },
  Grid: {
    cols: [1, 2, 3, 4, 5, 6, 8, 12],
    gaps: ['xs', 'sm', 'md', 'lg', 'xl'],
    responsive: true,
  },
  Button: {
    colors: ['accent', 'neutral', 'success', 'danger', 'warning', 'info'],
    sizes: ['small', 'medium', 'large'],
    variants: ['primary', 'secondary', 'tertiary'],
  },
  Card: {
    colors: ['neutral', 'accent'],
    sizes: ['small', 'medium', 'large'],
  },
  Text: {
    variants: ['body', 'subtitle', 'caption', 'overline'],
    sizes: ['xs', 'sm', 'md', 'lg', 'xl'],
    weights: ['normal', 'medium', 'semibold', 'bold'],
  },
  Heading: {
    levels: [1, 2, 3, 4, 5, 6],
    sizes: ['xsmall', 'small', 'medium', 'large', 'xlarge'],
  },
  Badge: {
    colors: ['neutral', 'accent', 'success', 'danger', 'warning', 'info'],
    sizes: ['small', 'medium', 'large'],
  },
};

// Generate comprehensive examples
function generateComponentExamples(componentName, config) {
  const examples = [];
  
  if (componentName === 'Stack') {
    // Basic Stack variations
    config.directions.forEach(direction => {
      config.gaps.forEach(gap => {
        examples.push({
          category: 'layout',
          subcategory: 'stack',
          title: `${direction.charAt(0).toUpperCase() + direction.slice(1)} Stack with ${gap.toUpperCase()} Gap`,
          description: `Stack component with ${direction} direction and ${gap} gap spacing`,
          code: `<Stack direction="${direction}" gap="${gap}">\n  <Text>Item 1</Text>\n  <Text>Item 2</Text>\n  <Text>Item 3</Text>\n</Stack>`,
          platformUi: 'primitives/Stack',
          tokens: { gap: getGapToken(gap) },
        });
      });
    });
    
    // Stack with alignment
    config.aligns.forEach(align => {
      examples.push({
        category: 'layout',
        subcategory: 'stack',
        title: `Horizontal Stack with ${align.charAt(0).toUpperCase() + align.slice(1)} Alignment`,
        description: `Horizontal stack aligned to ${align}`,
        code: `<Stack direction="horizontal" align="${align}" gap="sm">\n  <Button>Action 1</Button>\n  <Button>Action 2</Button>\n</Stack>`,
        platformUi: 'primitives/Stack',
      });
    });
    
    // Stack with justify
    config.justifies.forEach(justify => {
      examples.push({
        category: 'layout',
        subcategory: 'stack',
        title: `Stack with ${justify.charAt(0).toUpperCase() + justify.slice(1)} Justify`,
        description: `Stack with ${justify} justification`,
        code: `<Stack direction="horizontal" justify="${justify}" gap="sm">\n  <Button>Left</Button>\n  <Button>Right</Button>\n</Stack>`,
        platformUi: 'primitives/Stack',
      });
    });
    
    // Stack with padding
    config.paddings.forEach(px => {
      examples.push({
        category: 'layout',
        subcategory: 'stack',
        title: `Stack with ${px.toUpperCase()} Horizontal Padding`,
        description: `Stack with px="${px}" padding`,
        code: `<Stack direction="vertical" px="${px}" gap="md">\n  <Heading level={2}>Section Title</Heading>\n  <Paragraph>Content here</Paragraph>\n</Stack>`,
        platformUi: 'primitives/Stack',
        tokens: { px: getSpacingToken(px) },
      });
    });
    
    config.paddings.forEach(py => {
      examples.push({
        category: 'layout',
        subcategory: 'stack',
        title: `Stack with ${py.toUpperCase()} Vertical Padding`,
        description: `Stack with py="${py}" padding`,
        code: `<Stack direction="vertical" py="${py}" gap="md">\n  <Text>Top content</Text>\n  <Text>Bottom content</Text>\n</Stack>`,
        platformUi: 'primitives/Stack',
        tokens: { py: getSpacingToken(py) },
      });
    });
    
    // Responsive Stack patterns
    const responsivePatterns = [
      { base: 'vertical', md: 'horizontal' },
      { base: 'horizontal', md: 'vertical' },
    ];
    
    responsivePatterns.forEach(pattern => {
      examples.push({
        category: 'layout',
        subcategory: 'stack',
        title: `Responsive Stack Direction (${pattern.base} → ${pattern.md})`,
        description: `Stack that changes direction from ${pattern.base} on mobile to ${pattern.md} on desktop`,
        code: `<Stack direction={{ base: '${pattern.base}', md: '${pattern.md}' }} gap="md">\n  <Button>Button 1</Button>\n  <Button>Button 2</Button>\n</Stack>`,
        platformUi: 'primitives/Stack',
        responsive: true,
      });
    });
    
    // Responsive gap
    const gapPatterns = [
      { base: 'xs', md: 'sm', lg: 'md' },
      { base: 'sm', md: 'md', lg: 'lg' },
      { base: 'md', lg: 'lg', xl: 'xl' },
    ];
    
    gapPatterns.forEach(pattern => {
      const patternStr = Object.entries(pattern).map(([bp, gap]) => `${bp}: '${gap}'`).join(', ');
      examples.push({
        category: 'layout',
        subcategory: 'stack',
        title: `Responsive Stack Gap (${patternStr})`,
        description: `Stack with responsive gap that increases on larger screens`,
        code: `<Stack direction="vertical" gap={{ ${patternStr} }}>\n  <Card>Card 1</Card>\n  <Card>Card 2</Card>\n</Stack>`,
        platformUi: 'primitives/Stack',
        responsive: true,
      });
    });
    
    // Nested stacks
    examples.push({
      category: 'layout',
      subcategory: 'stack',
      title: 'Nested Stacks',
      description: 'Stack containing another stack',
      code: `<Stack direction="vertical" gap="lg">\n  <Stack direction="horizontal" gap="sm">\n    <Button>Action 1</Button>\n    <Button>Action 2</Button>\n  </Stack>\n  <Stack direction="vertical" gap="xs">\n    <Text>Item 1</Text>\n    <Text>Item 2</Text>\n  </Stack>\n</Stack>`,
      platformUi: 'primitives/Stack',
    });
  }
  
  if (componentName === 'Grid') {
    // Basic grid variations
    config.cols.forEach(cols => {
      config.gaps.forEach(gap => {
        examples.push({
          category: 'layout',
          subcategory: 'grid',
          title: `${cols} Column Grid with ${gap.toUpperCase()} Gap`,
          description: `Grid with ${cols} columns and ${gap} gap spacing`,
          code: `<Grid cols={${cols}} gap="${gap}">\n  {Array.from({ length: ${cols} }).map((_, i) => (\n    <Card key={i}>Card {i + 1}</Card>\n  ))}\n</Grid>`,
          platformUi: 'primitives/Grid',
          tokens: { gap: getGapToken(gap) },
        });
      });
    });
    
    // Responsive grid patterns
    const responsivePatterns = [
      { base: 1, md: 2 },
      { base: 1, md: 2, lg: 3 },
      { base: 1, sm: 2, lg: 4 },
      { base: 1, md: 3, lg: 4 },
      { base: 1, sm: 2, md: 3, lg: 4 },
      { base: 1, md: 2, lg: 3, xl: 4 },
      { base: 1, sm: 2, md: 4, lg: 6 },
      { base: 1, md: 2, lg: 4, xl: 6 },
    ];
    
    responsivePatterns.forEach(pattern => {
      const patternStr = Object.entries(pattern).map(([bp, cols]) => `${bp}: ${cols}`).join(', ');
      examples.push({
        category: 'layout',
        subcategory: 'grid',
        title: `Responsive Grid (${patternStr})`,
        description: `Grid that adapts from ${pattern.base} column on mobile to ${Object.values(pattern).pop()} columns on desktop`,
        code: `<Grid cols={{ ${patternStr} }} gap="md">\n  {items.map((item, i) => (\n    <Card key={i}>{item.title}</Card>\n  ))}\n</Grid>`,
        platformUi: 'primitives/Grid',
        responsive: true,
      });
    });
    
    // Responsive gap
    const gapPatterns = [
      { base: 'sm', md: 'md', lg: 'lg' },
      { base: 'xs', md: 'sm', lg: 'md' },
      { base: 'md', lg: 'lg', xl: 'xl' },
    ];
    
    gapPatterns.forEach(pattern => {
      const patternStr = Object.entries(pattern).map(([bp, gap]) => `${bp}: '${gap}'`).join(', ');
      examples.push({
        category: 'layout',
        subcategory: 'grid',
        title: `Responsive Grid Gap (${patternStr})`,
        description: `Grid with responsive gap spacing`,
        code: `<Grid cols={{ base: 1, md: 2 }} gap={{ ${patternStr} }}>\n  <Card>Card 1</Card>\n  <Card>Card 2</Card>\n</Grid>`,
        platformUi: 'primitives/Grid',
        responsive: true,
      });
    });
    
    // Auto-fit grid
    const autoFitWidths = ['240px', '280px', '320px', '360px'];
    autoFitWidths.forEach(width => {
      examples.push({
        category: 'layout',
        subcategory: 'grid',
        title: `Auto-fit Grid (min ${width})`,
        description: `Grid that automatically fits columns with minimum width ${width}`,
        code: `<Grid autoFit minColWidth="${width}" gap="md">\n  {items.map((item, i) => (\n    <Card key={i}>{item.title}</Card>\n  ))}\n</Grid>`,
        platformUi: 'primitives/Grid',
      });
    });
  }
  
  if (componentName === 'Button') {
    config.colors.forEach(color => {
      config.sizes.forEach(size => {
        examples.push({
          category: 'components',
          subcategory: 'button',
          title: `${color.charAt(0).toUpperCase() + color.slice(1)} ${size.charAt(0).toUpperCase() + size.slice(1)} Button`,
          description: `Button with ${color} color and ${size} size`,
          code: `<Button data-color="${color}" data-size="${size}" onClick={handleClick}>\n  Click Me\n</Button>`,
          platformUi: '@digdir/designsystemet-react',
          tokens: {
            'data-color': color,
            'data-size': size,
          },
        });
      });
    });
    
    // Button variants
    config.variants.forEach(variant => {
      examples.push({
        category: 'components',
        subcategory: 'button',
        title: `Button ${variant.charAt(0).toUpperCase() + variant.slice(1)} Variant`,
        description: `Button with ${variant} variant`,
        code: `<Button data-variant="${variant}" data-color="accent" data-size="medium">\n  ${variant.charAt(0).toUpperCase() + variant.slice(1)} Button\n</Button>`,
        platformUi: '@digdir/designsystemet-react',
        tokens: { 'data-variant': variant },
      });
    });
    
    // Button with icon
    examples.push({
      category: 'components',
      subcategory: 'button',
      title: 'Button with Icon',
      description: 'Button containing an icon',
      code: `<Button data-color="accent" data-size="medium">\n  <Stack direction="horizontal" gap="xs" align="center">\n    <SaveIcon style={{ width: 16, height: 16 }} />\n    <Text>Save</Text>\n  </Stack>\n</Button>`,
      platformUi: '@digdir/designsystemet-react + primitives/Stack',
    });
  }
  
  if (componentName === 'Text') {
    config.variants.forEach(variant => {
      config.sizes.forEach(size => {
        examples.push({
          category: 'components',
          subcategory: 'text',
          title: `Text ${variant.charAt(0).toUpperCase() + variant.slice(1)} ${size.toUpperCase()}`,
          description: `Text component with ${variant} variant and ${size} size`,
          code: `<Text variant="${variant}" size="${size}">\n  Text content\n</Text>`,
          platformUi: 'primitives/Text',
          tokens: { variant, size },
        });
      });
    });
    
    // Text with weight
    config.weights.forEach(weight => {
      examples.push({
        category: 'components',
        subcategory: 'text',
        title: `Text with ${weight.charAt(0).toUpperCase() + weight.slice(1)} Weight`,
        description: `Text with ${weight} font weight`,
        code: `<Text size="md" weight="${weight}">\n  ${weight.charAt(0).toUpperCase() + weight.slice(1)} text\n</Text>`,
        platformUi: 'primitives/Text',
        tokens: { weight },
      });
    });
    
    // Text with color
    const textColors = [
      { token: 'var(--ds-color-neutral-text-default)', name: 'default' },
      { token: 'var(--ds-color-neutral-text-subtle)', name: 'subtle' },
      { token: 'var(--ds-color-accent-text-default)', name: 'accent' },
    ];
    
    textColors.forEach(({ token, name }) => {
      examples.push({
        category: 'components',
        subcategory: 'text',
        title: `Text with ${name.charAt(0).toUpperCase() + name.slice(1)} Color`,
        description: `Text with ${name} color using design token`,
        code: `<Text size="md" style={{ color: '${token}' }}>\n  ${name.charAt(0).toUpperCase() + name.slice(1)} colored text\n</Text>`,
        platformUi: 'primitives/Text',
        tokens: { color: token },
      });
    });
  }
  
  if (componentName === 'Heading') {
    config.levels.forEach(level => {
      config.sizes.forEach(size => {
        examples.push({
          category: 'components',
          subcategory: 'heading',
          title: `Heading Level ${level} ${size.charAt(0).toUpperCase() + size.slice(1)}`,
          description: `Heading component with level ${level} and ${size} size`,
          code: `<Heading level={${level}} data-size="${size}">\n  Heading Text\n</Heading>`,
          platformUi: '@digdir/designsystemet-react',
          tokens: {
            level,
            'data-size': size,
          },
        });
      });
    });
  }
  
  if (componentName === 'Badge') {
    config.colors.forEach(color => {
      config.sizes.forEach(size => {
        examples.push({
          category: 'components',
          subcategory: 'badge',
          title: `${color.charAt(0).toUpperCase() + color.slice(1)} ${size.charAt(0).toUpperCase() + size.slice(1)} Badge`,
          description: `Badge with ${color} color and ${size} size`,
          code: `<Badge color="${color}" size="${size}">\n  Badge\n</Badge>`,
          platformUi: 'primitives/Badge',
          tokens: { color, size },
        });
      });
    });
  }
  
  return examples;
}

// Helper functions
function getGapToken(gap) {
  const map = { xs: '1', sm: '2', md: '4', lg: '6', xl: '8' };
  return `${gap} = var(--ds-spacing-${map[gap]})`;
}

function getSpacingToken(size) {
  const map = { xs: '1', sm: '2', md: '4', lg: '6', xl: '8' };
  return `${size} = var(--ds-spacing-${map[size]})`;
}

// Generate common patterns
function generateCommonPatterns() {
  return [
    // Form patterns
    {
      category: 'patterns',
      subcategory: 'form',
      title: 'Form with 2-Column Grid',
      description: 'Responsive form layout with 2 columns on desktop',
      code: `<Grid cols={{ base: 1, md: 2 }} gap="md">\n  <Stack direction="vertical" gap="xs">\n    <Label htmlFor="firstName">First Name</Label>\n    <Textfield id="firstName" data-size="medium" />\n  </Stack>\n  <Stack direction="vertical" gap="xs">\n    <Label htmlFor="lastName">Last Name</Label>\n    <Textfield id="lastName" data-size="medium" />\n  </Stack>\n</Grid>`,
      platformUi: 'primitives/Grid + primitives/Stack + @digdir/designsystemet-react',
      responsive: true,
    },
    {
      category: 'patterns',
      subcategory: 'form',
      title: 'Form with 3-Column Grid',
      description: 'Form with 3 columns on large screens',
      code: `<Grid cols={{ base: 1, md: 2, lg: 3 }} gap="md">\n  <Stack direction="vertical" gap="xs">\n    <Label htmlFor="field1">Field 1</Label>\n    <Textfield id="field1" data-size="medium" />\n  </Stack>\n  <Stack direction="vertical" gap="xs">\n    <Label htmlFor="field2">Field 2</Label>\n    <Textfield id="field2" data-size="medium" />\n  </Stack>\n  <Stack direction="vertical" gap="xs">\n    <Label htmlFor="field3">Field 3</Label>\n    <Textfield id="field3" data-size="medium" />\n  </Stack>\n</Grid>`,
      platformUi: 'primitives/Grid + primitives/Stack',
      responsive: true,
    },
    {
      category: 'patterns',
      subcategory: 'form',
      title: 'Form Actions Row',
      description: 'Form action buttons aligned to the right',
      code: `<Stack direction="horizontal" justify="end" gap="sm">\n  <Button data-variant="tertiary">Cancel</Button>\n  <Button data-color="accent">Save</Button>\n</Stack>`,
      platformUi: 'primitives/Stack + @digdir/designsystemet-react',
    },
    {
      category: 'patterns',
      subcategory: 'form',
      title: 'Form Section',
