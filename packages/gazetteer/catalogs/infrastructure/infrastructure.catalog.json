{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://xala.dev/catalogs/gazetteer/infrastructure.catalog.json",
    "title": "Application Infrastructure Catalog",
    "description": "Complete application infrastructure: providers, auth, API, BACs, teams, styling",
    "version": "1.0.0",
    "providerStack": {
        "description": "Required provider wrapping order (outermost first)",
        "order": [
            "React.StrictMode",
            "ErrorBoundary",
            "ThemeProvider",
            "I18nProvider",
            "RuntimeProvider",
            "AuthProvider",
            "TenantProvider",
            "ApiProvider",
            "GazetteerProvider",
            "BrowserRouter"
        ],
        "publicStackOrder": [
            "React.StrictMode",
            "ErrorBoundary",
            "ThemeProvider",
            "I18nProvider",
            "GazetteerProvider",
            "BrowserRouter"
        ]
    },
    "providers": {
        "ThemeProvider": {
            "import": "@xala-technologies/platform-ui",
            "description": "Injects design system styles and theme context",
            "props": {
                "theme": "'xala' | 'digilist' | 'neutral'",
                "mode": "'light' | 'dark' | 'system'"
            },
            "required": true
        },
        "I18nProvider": {
            "import": "@xala-technologies/platform/i18n",
            "description": "Internationalization context with locale management",
            "props": {
                "defaultLocale": "'nb' | 'en'",
                "supportedLocales": "string[]"
            },
            "required": true
        },
        "RuntimeProvider": {
            "import": "@xala-technologies/platform/runtime",
            "description": "Runtime configuration and environment variables",
            "props": {
                "config": {
                    "appId": "string",
                    "env": "import.meta.env",
                    "apiBaseUrl": "string",
                    "featureFlags": "Record<string, boolean>"
                }
            },
            "required": "auth apps only"
        },
        "AuthProvider": {
            "import": "@xala-technologies/platform/auth",
            "description": "Authentication state, session, login/logout",
            "props": {
                "loginRoute": "string",
                "dashboardRoute": "string",
                "onAuthStateChange": "(user: User | null) => void"
            },
            "provides": [
                "useAuth",
                "useUser",
                "useSession"
            ],
            "required": "auth apps only"
        },
        "TenantProvider": {
            "import": "@xala-technologies/platform/tenant",
            "description": "Multi-tenant context with team switching",
            "props": {
                "defaultTenantId": "string | null"
            },
            "provides": [
                "useTenant",
                "useTeam",
                "useTenantSwitcher"
            ],
            "required": "multi-tenant apps"
        },
        "ApiProvider": {
            "import": "@xala-technologies/platform/api",
            "description": "API client context with auth headers",
            "props": {
                "baseUrl": "string",
                "headers": "Record<string, string>"
            },
            "provides": [
                "useApi",
                "useQuery",
                "useMutation"
            ],
            "required": "apps with API calls"
        },
        "GazetteerProvider": {
            "import": "@xala-technologies/gazetteer/provider",
            "description": "Gazetteer spec loading and page rendering",
            "props": {
                "appId": "string",
                "specBasePath": "'/gazetteer'"
            },
            "required": true
        },
        "ErrorBoundary": {
            "import": "@xala-technologies/platform-ui",
            "description": "Catches React errors and shows fallback UI",
            "props": {
                "fallback": "ReactNode",
                "onError": "(error: Error) => void"
            },
            "required": true
        }
    },
    "authSystem": {
        "hooks": {
            "useAuth": {
                "returns": {
                    "user": "User | null",
                    "isAuthenticated": "boolean",
                    "isLoading": "boolean",
                    "login": "(credentials) => Promise<void>",
                    "logout": "() => Promise<void>",
                    "refresh": "() => Promise<void>"
                }
            },
            "useSession": {
                "returns": {
                    "session": "Session | null",
                    "accessToken": "string | null",
                    "expiresAt": "Date | null"
                }
            },
            "usePermissions": {
                "returns": {
                    "hasPermission": "(permission: string) => boolean",
                    "hasAnyPermission": "(permissions: string[]) => boolean",
                    "hasAllPermissions": "(permissions: string[]) => boolean"
                }
            }
        },
        "guards": {
            "AuthGuard": {
                "description": "Redirects to login if not authenticated",
                "props": {
                    "redirectTo": "string",
                    "fallback": "ReactNode"
                }
            },
            "RoleGuard": {
                "description": "Checks user has required role",
                "props": {
                    "roles": "string[]",
                    "mode": "'any' | 'all'",
                    "fallback": "ReactNode"
                }
            },
            "PermissionGuard": {
                "description": "Checks user has required permission",
                "props": {
                    "permissions": "string[]",
                    "mode": "'any' | 'all'",
                    "fallback": "ReactNode"
                }
            },
            "TenantGuard": {
                "description": "Ensures user has access to current tenant",
                "props": {
                    "tenantId": "string",
                    "fallback": "ReactNode"
                }
            }
        }
    },
    "bac": {
        "description": "Business Access Control - fine-grained permissions",
        "structure": {
            "resource": "Entity type (e.g., 'project', 'document', 'user')",
            "action": "Operation (e.g., 'create', 'read', 'update', 'delete', 'approve')",
            "scope": "Visibility ('own' | 'team' | 'tenant' | 'global')"
        },
        "examples": [
            "project:create:team",
            "document:read:own",
            "user:update:tenant",
            "invoice:approve:team"
        ],
        "hooks": {
            "useCan": {
                "usage": "useCan('project:create:team')",
                "returns": "boolean"
            },
            "useCanAny": {
                "usage": "useCanAny(['project:create', 'project:update'])",
                "returns": "boolean"
            }
        },
        "components": {
            "Can": {
                "description": "Conditional render based on permission",
                "usage": "<Can permission=\"project:create\">Create Button</Can>"
            },
            "Cannot": {
                "description": "Render when user lacks permission",
                "usage": "<Cannot permission=\"project:delete\">Read Only</Cannot>"
            }
        }
    },
    "tenantSystem": {
        "hooks": {
            "useTenant": {
                "returns": {
                    "tenant": "Tenant | null",
                    "tenantId": "string | null",
                    "tenants": "Tenant[]",
                    "switchTenant": "(id: string) => Promise<void>"
                }
            },
            "useTeam": {
                "returns": {
                    "team": "Team | null",
                    "teams": "Team[]",
                    "switchTeam": "(id: string) => Promise<void>",
                    "teamMembers": "TeamMember[]"
                }
            }
        },
        "components": {
            "TenantSwitcher": {
                "description": "Dropdown to switch between tenants",
                "platformUi": "composed/TenantSwitcher"
            },
            "TeamSwitcher": {
                "description": "Dropdown to switch between teams",
                "platformUi": "composed/TeamSwitcher"
            }
        }
    },
    "apiConnection": {
        "client": {
            "import": "@xala-technologies/platform/api",
            "description": "Type-safe API client with auth",
            "features": [
                "Automatic auth header injection",
                "Request/response interceptors",
                "Error handling and retry",
                "Tenant context in headers"
            ]
        },
        "hooks": {
            "useQuery": {
                "description": "Fetch data with caching",
                "usage": "useQuery(['projects'], () => api.projects.list())"
            },
            "useMutation": {
                "description": "Mutate data with optimistic updates",
                "usage": "useMutation((data) => api.projects.create(data))"
            },
            "useInfiniteQuery": {
                "description": "Paginated/infinite scroll data",
                "usage": "useInfiniteQuery(['projects'], fetchProjectsPage)"
            }
        },
        "sdkPattern": {
            "description": "Domain SDK controllers for data access",
            "structure": {
                "sdk.projects.list()": "GET /api/projects",
                "sdk.projects.get(id)": "GET /api/projects/:id",
                "sdk.projects.create(data)": "POST /api/projects",
                "sdk.projects.update(id, data)": "PUT /api/projects/:id",
                "sdk.projects.delete(id)": "DELETE /api/projects/:id"
            }
        },
        "headers": {
            "Authorization": "Bearer {accessToken}",
            "X-Tenant-Id": "{currentTenantId}",
            "X-Team-Id": "{currentTeamId}",
            "Accept-Language": "{currentLocale}"
        }
    },
    "styling": {
        "entry": "@xala-technologies/platform-ui/styles",
        "includes": [
            "@digdir/designsystemet-css",
            "@fontsource/inter",
            "xala.css (theme tokens)",
            "xala-extensions.css (custom utilities)"
        ],
        "themes": {
            "xala": {
                "brandColor": "#0062BA",
                "description": "Xala platform default theme"
            },
            "digilist": {
                "brandColor": "#2563EB",
                "description": "Digilist product theme"
            },
            "neutral": {
                "brandColor": "#6B7280",
                "description": "Neutral/grayscale theme"
            }
        },
        "modeSwitch": {
            "attribute": "data-color-scheme",
            "values": [
                "light",
                "dark"
            ],
            "hook": "useColorScheme()"
        }
    },
    "scaffoldStructure": {
        "authApp": {
            "files": [
                "package.json",
                "tsconfig.json",
                "vite.config.ts",
                "index.html",
                "src/main.tsx",
                "gazetteer/app.spec.json",
                "gazetteer/pages/*.page.json",
                "gazetteer/routes/*.route.json",
                "gazetteer/i18n/nb.json",
                "gazetteer/i18n/en.json"
            ],
            "mainTsx": {
                "providers": [
                    "ErrorBoundary",
                    "ThemeProvider",
                    "I18nProvider",
                    "RuntimeProvider",
                    "AuthProvider",
                    "ApiProvider",
                    "TenantProvider",
                    "GazetteerProvider",
                    "BrowserRouter"
                ],
                "guards": [
                    "AuthGuard on protected routes"
                ]
            }
        },
        "publicApp": {
            "files": [
                "package.json",
                "tsconfig.json",
                "vite.config.ts",
                "index.html",
                "src/main.tsx",
                "gazetteer/app.spec.json",
                "gazetteer/pages/*.page.json",
                "gazetteer/routes/*.route.json",
                "gazetteer/i18n/nb.json",
                "gazetteer/i18n/en.json"
            ],
            "mainTsx": {
                "providers": [
                    "ErrorBoundary",
                    "ThemeProvider",
                    "I18nProvider",
                    "GazetteerProvider",
                    "BrowserRouter"
                ],
                "guards": []
            }
        }
    },
    "envVariables": {
        "required": {
            "VITE_API_URL": "API base URL",
            "VITE_APP_ID": "Application identifier"
        },
        "optional": {
            "VITE_AUTH_PROVIDER": "OAuth provider (default: 'xala')",
            "VITE_TENANT_ID": "Default tenant ID",
            "VITE_FEATURE_FLAGS": "JSON string of feature flags",
            "VITE_SENTRY_DSN": "Error tracking DSN"
        }
    }
}