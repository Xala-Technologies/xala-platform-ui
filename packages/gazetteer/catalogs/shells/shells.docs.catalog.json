{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://xala.dev/catalogs/gazetteer/shells.docs.catalog.json",
    "title": "Documentation Site Shell Widgets",
    "description": "Widgets for documentation sites with TOC, search, tree navigation",
    "version": "1.0.0",
    "shellType": "public",
    "auth": false,
    "designTokens": {
        "grid": {
            "docsLayout": "Grid cols={{ base: 1, lg: '280px 1fr 200px' }} gap='lg'",
            "contentOnly": "Grid cols={{ base: 1, lg: '280px 1fr' }} gap='lg'",
            "fullWidth": "Stack gap='md' direction='vertical'"
        },
        "spacing": {
            "sidebarPadding": "var(--ds-spacing-4)",
            "contentPadding": "var(--ds-spacing-6)",
            "headingGap": "var(--ds-spacing-4)"
        },
        "maxWidth": {
            "content": "800px",
            "sidebar": "280px",
            "toc": "200px"
        },
        "typography": {
            "docTitle": "var(--ds-font-size-heading-large)",
            "sectionTitle": "var(--ds-font-size-heading-medium)",
            "body": "var(--ds-font-size-body-medium)",
            "code": "var(--ds-font-size-body-small)"
        }
    },
    "types": [
        {
            "type": "DocsPageShell",
            "description": "Documentation page layout with sidebar, content, TOC",
            "category": "scaffold",
            "platformUi": "shells/AppLayout",
            "slots": [
                "header",
                "sidebar",
                "content",
                "toc",
                "footer"
            ],
            "props": {
                "sidebarCollapsible": "boolean",
                "tocEnabled": "boolean",
                "searchEnabled": "boolean",
                "versionSelector": "boolean"
            }
        },
        {
            "type": "DocsSidebar",
            "description": "Hierarchical navigation tree (like Tailwind docs)",
            "category": "navigation",
            "platformUi": "composed/CatalogSidebar",
            "bindings": {
                "items": "vm.navTree",
                "activePath": "vm.activePath"
            },
            "props": {
                "expandable": "boolean",
                "searchable": "boolean",
                "grouped": "boolean"
            }
        },
        {
            "type": "DocsTreeView",
            "description": "Tree navigation for nested docs structure",
            "category": "navigation",
            "platformUi": "composed/TreeView",
            "bindings": {
                "items": "vm.tree",
                "expanded": "vm.expandedNodes",
                "selected": "vm.selectedNode"
            },
            "props": {
                "showIcons": "boolean",
                "multiSelect": "boolean"
            }
        },
        {
            "type": "TableOfContents",
            "description": "In-page table of contents (right sidebar)",
            "category": "navigation",
            "platformUi": "blocks/TableOfContents",
            "bindings": {
                "headings": "vm.headings",
                "activeHeading": "vm.activeHeading"
            },
            "props": {
                "maxDepth": "2 | 3 | 4",
                "sticky": "boolean"
            }
        },
        {
            "type": "DocsSearch",
            "description": "Documentation search with command palette",
            "category": "search",
            "platformUi": "composed/CommandPalette",
            "props": {
                "placeholder": "string",
                "shortcut": "string",
                "indexUrl": "string"
            }
        },
        {
            "type": "DocsChatbot",
            "description": "AI chatbot for documentation questions",
            "category": "ai",
            "platformUi": "blocks/DocsChatbot",
            "props": {
                "position": "'bottom-right' | 'sidebar'",
                "welcomeMessage": "string",
                "suggestedQuestions": "string[]"
            }
        },
        {
            "type": "CodeBlock",
            "description": "Syntax-highlighted code with copy button",
            "category": "content",
            "platformUi": "composed/CodeBlock",
            "props": {
                "language": "string",
                "title": "string",
                "showLineNumbers": "boolean",
                "highlightLines": "number[]",
                "copyable": "boolean"
            }
        },
        {
            "type": "VersionSelector",
            "description": "Documentation version dropdown",
            "category": "navigation",
            "platformUi": "blocks/VersionSelector",
            "bindings": {
                "versions": "vm.versions",
                "current": "vm.currentVersion"
            }
        },
        {
            "type": "PrevNextNav",
            "description": "Previous/Next page navigation",
            "category": "navigation",
            "platformUi": "blocks/PrevNextNav",
            "bindings": {
                "prev": "vm.prevPage",
                "next": "vm.nextPage"
            }
        },
        {
            "type": "ApiReference",
            "description": "API reference table with types/params",
            "category": "content",
            "platformUi": "blocks/ApiReference",
            "bindings": {
                "api": "vm.apiSpec"
            },
            "props": {
                "showExamples": "boolean",
                "expandable": "boolean"
            }
        },
        {
            "type": "EditOnGitHub",
            "description": "Edit this page on GitHub link",
            "category": "action",
            "platformUi": "blocks/EditOnGitHub",
            "props": {
                "repo": "string",
                "branch": "string",
                "path": "string"
            }
        },
        {
            "type": "FeedbackWidget",
            "description": "Was this page helpful? feedback",
            "category": "feedback",
            "platformUi": "patterns/FeedbackForm",
            "props": {
                "variant": "'thumbs' | 'stars' | 'emoji'"
            }
        }
    ],
    "enum": [
        "DocsPageShell",
        "DocsSidebar",
        "DocsTreeView",
        "TableOfContents",
        "DocsSearch",
        "DocsChatbot",
        "CodeBlock",
        "VersionSelector",
        "PrevNextNav",
        "ApiReference",
        "EditOnGitHub",
        "FeedbackWidget"
    ]
}