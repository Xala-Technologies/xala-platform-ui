{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://xala.dev/catalogs/gazetteer/widgets.tables.catalog.json",
    "title": "Tables & Filters Widgets",
    "description": "Widgets for data tables, filtering, and list pages",
    "version": "1.0.0",
    "designTokens": {
        "grid": {
            "tableContainer": "Stack gap='md' direction='vertical'",
            "filterBar": "Stack gap='sm' direction='horizontal' wrap",
            "toolbar": "Stack gap='sm' direction='horizontal' justify='between'"
        },
        "spacing": {
            "toolbarGap": "var(--ds-spacing-4)",
            "filterGap": "var(--ds-spacing-2)",
            "rowPadding": "var(--ds-spacing-3)"
        },
        "maxWidth": {
            "list": "1440px",
            "filterPanel": "320px"
        },
        "density": {
            "compact": {
                "rowHeight": "40px",
                "padding": "var(--ds-spacing-2)"
            },
            "comfortable": {
                "rowHeight": "52px",
                "padding": "var(--ds-spacing-3)"
            },
            "relaxed": {
                "rowHeight": "64px",
                "padding": "var(--ds-spacing-4)"
            }
        }
    },
    "types": [
        {
            "type": "DataTableBundle",
            "description": "Complete data table with toolbar, filters, pagination",
            "category": "scaffold",
            "platformUi": "composed/DataTable",
            "slots": [
                "toolbar",
                "filters",
                "table",
                "pagination"
            ],
            "bindings": {
                "items": "vm.items",
                "pagination": "vm.pagination",
                "sort": "vm.sort",
                "filters": "vm.filters",
                "selection": "vm.selectedIds"
            },
            "props": {
                "tableId": "string (required)",
                "columnsRef": "string (required)",
                "densityToggle": "boolean",
                "columnSettings": "boolean",
                "selectable": "boolean",
                "stickyHeader": "boolean"
            }
        },
        {
            "type": "EntityTable",
            "description": "Data table with sorting, row actions, pagination",
            "category": "data",
            "platformUi": "composed/DataTable",
            "bindings": {
                "data": "vm.items",
                "columns": "vm.columns"
            },
            "props": {
                "sortable": "boolean",
                "selectable": "boolean",
                "rowActions": "ActionDefinition[]"
            }
        },
        {
            "type": "ListToolbar",
            "description": "Toolbar with search, filters, actions, view toggle",
            "category": "layout",
            "platformUi": "composed/ListToolbar",
            "props": {
                "searchEnabled": "boolean",
                "createEnabled": "boolean",
                "viewToggle": "'grid' | 'list' | 'table'",
                "bulkActions": "ActionDefinition[]"
            }
        },
        {
            "type": "FilterBar",
            "description": "Horizontal filter controls with chips",
            "category": "form",
            "platformUi": "composed/filter-bar",
            "bindings": {
                "filters": "vm.filters"
            },
            "props": {
                "filtersRef": "string",
                "showClear": "boolean"
            }
        },
        {
            "type": "FilterPanel",
            "description": "Advanced filter panel (drawer or sidebar)",
            "category": "form",
            "platformUi": "composed/FilterPanel",
            "bindings": {
                "filters": "vm.advancedFilters",
                "savedViews": "vm.savedViews"
            },
            "props": {
                "position": "'drawer' | 'sidebar'",
                "collapsible": "boolean"
            }
        },
        {
            "type": "FilterChipsBar",
            "description": "Active filter chips with remove buttons",
            "category": "form",
            "platformUi": "composed/FilterChipsBar",
            "bindings": {
                "activeFilters": "vm.activeFilters"
            }
        },
        {
            "type": "TableConditionsFilter",
            "description": "Advanced condition builder for complex filters",
            "category": "form",
            "platformUi": "composed/TableConditionsFilter",
            "props": {
                "fields": "FilterFieldDefinition[]",
                "operators": "FilterOperator[]"
            }
        },
        {
            "type": "TableRowActions",
            "description": "Row-level action menu",
            "category": "action",
            "platformUi": "composed/TableRowActions",
            "props": {
                "actions": "ActionDefinition[]",
                "showInline": "number"
            }
        },
        {
            "type": "SelectionActionsBar",
            "description": "Bulk action bar for selected rows",
            "category": "action",
            "platformUi": "patterns/SelectionActionsBar",
            "bindings": {
                "selectedCount": "vm.selectedCount"
            },
            "props": {
                "actions": "ActionDefinition[]"
            }
        },
        {
            "type": "InfiniteScroll",
            "description": "Infinite scroll container for large lists",
            "category": "layout",
            "platformUi": "composed/InfiniteScroll",
            "bindings": {
                "items": "vm.items",
                "hasMore": "vm.hasMore",
                "loading": "vm.loading"
            }
        }
    ],
    "enum": [
        "DataTableBundle",
        "EntityTable",
        "ListToolbar",
        "FilterBar",
        "FilterPanel",
        "FilterChipsBar",
        "TableConditionsFilter",
        "TableRowActions",
        "SelectionActionsBar",
        "InfiniteScroll"
    ]
}