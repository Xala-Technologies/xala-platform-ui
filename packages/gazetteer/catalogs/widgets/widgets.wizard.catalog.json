{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://xala.dev/catalogs/gazetteer/widgets.wizard.catalog.json",
    "title": "Wizard & Multi-Step Widgets",
    "description": "Widgets for wizard flows, onboarding, and multi-step processes",
    "version": "1.0.0",
    "designTokens": {
        "grid": {
            "wizardLayout": "Grid cols={{ base: 1, lg: '280px 1fr' }} gap='lg'",
            "stepContent": "Stack gap='lg' direction='vertical'"
        },
        "spacing": {
            "stepGap": "var(--ds-spacing-8)",
            "fieldGap": "var(--ds-spacing-4)",
            "sidebarPadding": "var(--ds-spacing-4)"
        },
        "maxWidth": {
            "wizard": "960px",
            "modal": "640px",
            "content": "560px"
        }
    },
    "types": [
        {
            "type": "WizardScaffold",
            "description": "Complete wizard layout with sidebar and content",
            "category": "scaffold",
            "platformUi": "patterns/MultiStepFormModal",
            "slots": [
                "sidebar",
                "content",
                "footer"
            ],
            "bindings": {
                "currentStep": "vm.currentStep",
                "steps": "vm.steps",
                "completed": "vm.completedSteps"
            },
            "props": {
                "wizardId": "string (required)",
                "stepsRef": "string (required)",
                "allowSkip": "boolean",
                "showProgress": "boolean",
                "linear": "boolean"
            }
        },
        {
            "type": "Stepper",
            "description": "Step indicator with progress",
            "category": "navigation",
            "platformUi": "composed/Stepper",
            "bindings": {
                "currentStep": "vm.currentStep",
                "steps": "vm.steps"
            },
            "props": {
                "orientation": "'horizontal' | 'vertical'",
                "variant": "'default' | 'dots' | 'progress'"
            }
        },
        {
            "type": "StepperHeader",
            "description": "Wizard step header with title and description",
            "category": "layout",
            "platformUi": "patterns/StepperHeader",
            "props": {
                "stepNumber": "number",
                "titleKey": "string",
                "descriptionKey": "string"
            }
        },
        {
            "type": "WizardStepper",
            "description": "Vertical wizard navigation sidebar",
            "category": "navigation",
            "platformUi": "composed/WizardStepper",
            "bindings": {
                "steps": "vm.steps",
                "currentStep": "vm.currentStep",
                "validSteps": "vm.validSteps"
            }
        },
        {
            "type": "WizardStatusSidebar",
            "description": "Wizard sidebar with status and help",
            "category": "navigation",
            "platformUi": "blocks/WizardStatusSidebar",
            "props": {
                "helpEnabled": "boolean",
                "previewEnabled": "boolean"
            }
        },
        {
            "type": "FormWizardModal",
            "description": "Multi-step form in modal",
            "category": "scaffold",
            "platformUi": "patterns/FormWizardModal",
            "props": {
                "titleKey": "string",
                "stepsRef": "string",
                "width": "'sm' | 'md' | 'lg' | 'xl'"
            }
        },
        {
            "type": "ReviewStep",
            "description": "Summary/review step before submission",
            "category": "layout",
            "platformUi": "patterns/ReviewStep",
            "bindings": {
                "data": "vm.formData"
            },
            "props": {
                "editable": "boolean",
                "sections": "ReviewSection[]"
            }
        },
        {
            "type": "SuccessView",
            "description": "Success confirmation with next actions",
            "category": "feedback",
            "platformUi": "patterns/SuccessView",
            "props": {
                "titleKey": "string",
                "messageKey": "string",
                "primaryAction": "ActionDefinition",
                "secondaryAction": "ActionDefinition"
            }
        },
        {
            "type": "ConfirmationView",
            "description": "Pre-submission confirmation view",
            "category": "feedback",
            "platformUi": "patterns/ConfirmationView",
            "props": {
                "titleKey": "string",
                "warningsEnabled": "boolean"
            }
        },
        {
            "type": "ClarificationPanel",
            "description": "AI-powered clarification questions",
            "category": "ai",
            "platformUi": "blocks/ClarificationPanel",
            "bindings": {
                "questions": "vm.clarifications"
            }
        }
    ],
    "enum": [
        "WizardScaffold",
        "Stepper",
        "StepperHeader",
        "WizardStepper",
        "WizardStatusSidebar",
        "FormWizardModal",
        "ReviewStep",
        "SuccessView",
        "ConfirmationView",
        "ClarificationPanel"
    ]
}