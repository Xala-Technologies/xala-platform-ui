{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://xala.dev/catalogs/gazetteer/widgets.responsive.catalog.json",
    "title": "Responsive Design System",
    "description": "Mobile-first responsive patterns, breakpoints, and layout primitives",
    "version": "1.0.0",
    "designPrinciples": {
        "approach": "Mobile-first",
        "rule": "Start with mobile styles, add complexity for larger screens"
    },
    "breakpoints": {
        "base": {
            "min": "0px",
            "description": "Mobile phones (portrait)"
        },
        "sm": {
            "min": "640px",
            "description": "Mobile phones (landscape), small tablets"
        },
        "md": {
            "min": "768px",
            "description": "Tablets"
        },
        "lg": {
            "min": "1024px",
            "description": "Laptops, small desktops"
        },
        "xl": {
            "min": "1280px",
            "description": "Desktops"
        },
        "2xl": {
            "min": "1536px",
            "description": "Large desktops"
        }
    },
    "responsivePatterns": {
        "stackToGrid": {
            "description": "Vertical stack on mobile, grid on larger screens",
            "pattern": "Grid cols={{ base: 1, md: 2, lg: 3 }}"
        },
        "hideOnMobile": {
            "description": "Hidden on mobile, visible on desktop",
            "pattern": "display={{ base: 'none', lg: 'block' }}"
        },
        "showOnMobile": {
            "description": "Visible on mobile only",
            "pattern": "display={{ base: 'block', lg: 'none' }}"
        },
        "sidebarLayout": {
            "description": "Overlay drawer on mobile, persistent on desktop",
            "mobile": "Drawer overlay, triggered by hamburger",
            "desktop": "Fixed sidebar, 280px width"
        },
        "tableToCards": {
            "description": "Table on desktop, card list on mobile",
            "mobile": "Stack of cards",
            "desktop": "Full data table"
        }
    },
    "types": [
        {
            "type": "ResponsiveContainer",
            "description": "Max-width container with responsive padding",
            "category": "layout",
            "platformUi": "primitives/Container",
            "props": {
                "maxWidth": "'sm' | 'md' | 'lg' | 'xl' | 'full'",
                "padding": "ResponsivePadding",
                "centered": "boolean"
            },
            "responsive": {
                "base": "px: 16px, maxWidth: 100%",
                "sm": "px: 24px",
                "lg": "px: 32px, maxWidth: varies"
            }
        },
        {
            "type": "ResponsiveGrid",
            "description": "Grid with responsive column configuration",
            "category": "layout",
            "platformUi": "primitives/Grid",
            "props": {
                "cols": "ResponsiveCols",
                "gap": "ResponsiveGap"
            },
            "examples": [
                "cols={{ base: 1, md: 2, lg: 3 }}",
                "gap={{ base: 'sm', md: 'md', lg: 'lg' }}"
            ]
        },
        {
            "type": "ResponsiveStack",
            "description": "Stack with responsive direction and gap",
            "category": "layout",
            "platformUi": "primitives/Stack",
            "props": {
                "direction": "ResponsiveDirection",
                "gap": "ResponsiveGap"
            },
            "examples": [
                "direction={{ base: 'vertical', md: 'horizontal' }}",
                "gap={{ base: 'sm', lg: 'lg' }}"
            ]
        },
        {
            "type": "ShowOnMobile",
            "description": "Content visible only on mobile",
            "category": "responsive",
            "platformUi": "primitives/Show",
            "props": {
                "below": "'sm' | 'md' | 'lg'"
            }
        },
        {
            "type": "HideOnMobile",
            "description": "Content hidden on mobile",
            "category": "responsive",
            "platformUi": "primitives/Hide",
            "props": {
                "below": "'sm' | 'md' | 'lg'"
            }
        },
        {
            "type": "MobileCardView",
            "description": "Card-based view for mobile tables",
            "category": "responsive",
            "platformUi": "composed/MobileCardView",
            "bindings": {
                "items": "vm.items"
            },
            "props": {
                "cardTemplate": "CardTemplate"
            }
        },
        {
            "type": "ResponsiveImage",
            "description": "Image with srcset for different screen sizes",
            "category": "media",
            "platformUi": "primitives/ResponsiveImage",
            "props": {
                "src": "string",
                "srcSet": "SrcSetConfig",
                "aspectRatio": "'square' | '16:9' | '4:3' | 'auto'"
            }
        },
        {
            "type": "TouchTarget",
            "description": "Minimum 44x44px touch target wrapper",
            "category": "accessibility",
            "platformUi": "primitives/TouchTarget",
            "props": {
                "minSize": "44"
            }
        }
    ],
    "responsiveSpacing": {
        "padding": {
            "page": {
                "base": "var(--ds-spacing-4)",
                "md": "var(--ds-spacing-6)",
                "lg": "var(--ds-spacing-8)"
            },
            "section": {
                "base": "var(--ds-spacing-6)",
                "lg": "var(--ds-spacing-10)"
            },
            "card": {
                "base": "var(--ds-spacing-3)",
                "md": "var(--ds-spacing-4)"
            }
        },
        "gap": {
            "grid": {
                "base": "var(--ds-spacing-3)",
                "md": "var(--ds-spacing-4)",
                "lg": "var(--ds-spacing-6)"
            }
        }
    },
    "enum": [
        "ResponsiveContainer",
        "ResponsiveGrid",
        "ResponsiveStack",
        "ShowOnMobile",
        "HideOnMobile",
        "MobileCardView",
        "ResponsiveImage",
        "TouchTarget"
    ]
}