{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://xala.dev/catalogs/gazetteer/widgets.crud.catalog.json",
    "title": "CRUD Flow Widgets",
    "description": "Widgets for Create/Read/Update/Delete operations",
    "version": "1.0.0",
    "designTokens": {
        "grid": {
            "formLayout": "Grid cols={1} gap='lg'",
            "twoColumn": "Grid cols={{ base: 1, md: 2 }} gap='md'",
            "threeColumn": "Grid cols={{ base: 1, md: 2, lg: 3 }} gap='md'"
        },
        "spacing": {
            "sectionGap": "var(--ds-spacing-8)",
            "fieldGap": "var(--ds-spacing-4)",
            "inlineGap": "var(--ds-spacing-2)"
        },
        "maxWidth": {
            "form": "720px",
            "drawer": "480px",
            "modal": "560px"
        }
    },
    "types": [
        {
            "type": "FormScaffold",
            "description": "Complete form layout with sections, validation, sticky actions",
            "category": "scaffold",
            "platformUi": "patterns/MultiStepFormModal",
            "slots": [
                "sections",
                "actions",
                "rightDrawer"
            ],
            "props": {
                "formId": "string (required)",
                "submitActionId": "string (required)",
                "cancelActionId": "string",
                "schemaRef": "string (JSON Schema ref)",
                "density": "'compact' | 'comfortable' | 'relaxed'",
                "stickyActions": "boolean"
            }
        },
        {
            "type": "FormLayout",
            "description": "Form field organization with grid and sections",
            "category": "layout",
            "platformUi": "composed/FormLayout",
            "props": {
                "columns": "1 | 2 | 3",
                "gap": "'sm' | 'md' | 'lg'"
            }
        },
        {
            "type": "FormSection",
            "description": "Grouped form fields with title and description",
            "category": "layout",
            "platformUi": "composed/FormSection",
            "props": {
                "titleKey": "string",
                "descriptionKey": "string",
                "collapsible": "boolean"
            }
        },
        {
            "type": "DrawerForm",
            "description": "Side drawer with form for create/edit",
            "category": "form",
            "platformUi": "composed/Drawer",
            "props": {
                "width": "'sm' | 'md' | 'lg' | 'xl'",
                "position": "'left' | 'right'",
                "titleKey": "string"
            }
        },
        {
            "type": "SchemaForm",
            "description": "Auto-generated form from JSON Schema",
            "category": "form",
            "platformUi": "composed/SchemaForm",
            "bindings": {
                "schema": "vm.formSchema",
                "data": "vm.formData",
                "errors": "vm.formErrors"
            }
        },
        {
            "type": "DynamicForm",
            "description": "Runtime-configurable form with field definitions",
            "category": "form",
            "platformUi": "patterns/DynamicForm",
            "props": {
                "fields": "FieldDefinition[]"
            }
        },
        {
            "type": "ConfirmDialog",
            "description": "Confirmation modal for delete/destructive actions",
            "category": "feedback",
            "platformUi": "composed/ConfirmDialog",
            "props": {
                "titleKey": "string",
                "messageKey": "string",
                "confirmLabelKey": "string",
                "variant": "'danger' | 'warning' | 'info'"
            }
        },
        {
            "type": "FormActions",
            "description": "Submit/cancel button group with sticky positioning",
            "category": "form",
            "platformUi": "composed/FormActions",
            "props": {
                "submitLabelKey": "string",
                "cancelLabelKey": "string",
                "loading": "boolean",
                "sticky": "boolean"
            }
        }
    ],
    "enum": [
        "FormScaffold",
        "FormLayout",
        "FormSection",
        "DrawerForm",
        "SchemaForm",
        "DynamicForm",
        "ConfirmDialog",
        "FormActions"
    ]
}